# bin2h.cmake - embed a binary blob (SPIR-V) as an aligned byte array.
# Invoked as: cmake -DINPUT=... -DOUTPUT=... -DVAR=... -P cmake/bin2h.cmake
# SPIR-V sizes are multiples of 4, so the alignas(4) byte array satisfies
# VkShaderModuleCreateInfo's uint32_t pCode alignment through a cast.

file(READ "${INPUT}" blob HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " body "${blob}")
file(WRITE "${OUTPUT}"
  "/* Generated by cmake/bin2h.cmake - do not edit. */\n"
  "#pragma once\n"
  "#include <cstddef>\n"
  "#include <cstdint>\n"
  "namespace tge::gpu::spv {\n"
  "alignas(4) inline constexpr std::uint8_t ${VAR}[] = {${body}};\n"
  "inline constexpr std::size_t ${VAR}_bytes = sizeof(${VAR});\n"
  "}  // namespace tge::gpu::spv\n")
