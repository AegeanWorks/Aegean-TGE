# AIKit transient state
.aikit/*.lock
.aikit/*.bak
.aikit/*.tmp_*
.aikit/*.corrupt_*
__pycache__/
*.py[cod]
node_modules/

# Build output
build/
out/
.cache/
compile_commands.json

# Model weights are never committed. Anchored to the repository root so source
# directories called "models" are not swallowed by the pattern.
/models/
*.gguf
benchmarks/results/*.json

# arXiv draft lives on the author's desktop, not in the repo.
docs/fused-correction.md
docs/fused-correction.tex
